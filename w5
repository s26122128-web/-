    <!-- Audio Effects Controller using Web Audio API -->
    <script>
        // Web Audio API Synthesizer (No external audio asset dependencies)
        class SoundFX {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
            }
            playClick() {
                this.init();
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.05);
                gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.05);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.05);
            }
            playFlip() {
                this.init();
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(200, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(600, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }
            playFanfare() {
                this.init();
                if (!this.ctx) return;
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.value = freq;
                    const startTime = this.ctx.currentTime + (idx * 0.08);
                    gain.gain.setValueAtTime(0.2, startTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.3);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(startTime);
                    osc.stop(startTime + 0.3);
                });
            }
        }
        const sfx = new SoundFX();
    </script>

    <!-- Main Game Logic JavaScript -->
    <script>
        // ================= CONFIGURATION & GLOBAL STATE =================
        const GAS_API_URL = "https://script.google.com/macros/s/AKfycbybgIrkWrVgRkq6MB8y5gWZgT-jpkWOrUJw8KvAp6Y8kuwKThpuyaWehiLI31VdI3D5/exec";

        let state = {
            roomCode: '',
            playerName: '',
            isHost: false,
            hostPanelVisible: false,
            status: 'setup', // 'setup' | 'playing' | 'revealed'
            question: '',
            answers: {}, // { playerName: answerString }
            pollingTimer: null,
            previousStatus: 'setup',
            localFallbackMode: false,
            lastRawAnswersJSON: ''
        };

        // Japanese Retro Color Palette for revealed matching answers
        const MATCH_COLORS = [
            { bg: 'bg-terracotta/20', border: 'border-terracotta', text: 'text-terracotta-dark', badge: 'bg-terracotta text-white' },
            { bg: 'bg-matcha/20', border: 'border-matcha', text: 'text-matcha-dark', badge: 'bg-matcha text-white' },
            { bg: 'bg-mustard/30', border: 'border-mustard-dark', text: 'text-kraft-900', badge: 'bg-mustard text-kraft-900' },
            { bg: 'bg-amber-100', border: 'border-amber-700', text: 'text-amber-900', badge: 'bg-amber-700 text-white' },
            { bg: 'bg-emerald-100', border: 'border-emerald-700', text: 'text-emerald-900', badge: 'bg-emerald-700 text-white' },
        ];

        // Local Storage / Memory Simulated Backend Fallback (if GAS API experiences CORS or offline issues)
        const localSimulatedDB = {};

        // ================= TOAST NOTIFICATION UTILITY =================
        function showToast(msg, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgClass = type === 'error' ? 'bg-terracotta text-white' : (type === 'success' ? 'bg-matcha text-white' : 'bg-kraft-900 text-kraft-50');
            toast.className = `px-4 py-2.5 rounded-xl border-2 border-kraft-900 shadow-retro font-bold text-sm transform transition-all duration-300 translate-y-2 opacity-0 pointer-events-auto ${bgClass}`;
            toast.textContent = msg;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ================= ROOM JOIN & INITIALIZATION =================
        function generateRandomRoom() {
            const rand = Math.floor(1000 + Math.random() * 9000).toString();
            document.getElementById('inputRoomCode').value = rand;
            sfx.playClick();
        }

        function handleJoinRoom(e) {
            e.preventDefault();
            sfx.playClick();

            const name = document.getElementById('inputPlayerName').value.trim();
            const room = document.getElementById('inputRoomCode').value.trim().toUpperCase();
            const isHost = document.getElementById('chkIsHost').checked;

            if (!name || !room) {
                showToast('請完整填寫暱稱與房號！', 'error');
                return;
            }

            state.playerName = name;
            state.roomCode = room;
            state.isHost = isHost;

            // UI Adjustments for Game View
            document.getElementById('displayRoomCode').textContent = room;
            document.getElementById('displayPlayerName').textContent = name;
            
            if (isHost) {
                document.getElementById('hostBadge').classList.remove('hidden');
                document.getElementById('hostIndicatorDot').classList.remove('hidden');
                setHostPanelVisibility(true);
            } else {
                document.getElementById('hostBadge').classList.add('hidden');
                document.getElementById('hostIndicatorDot').classList.add('hidden');
                setHostPanelVisibility(false);
            }

            // Switch Screen Views
            document.getElementById('viewLogin').classList.add('hidden');
            document.getElementById('viewGame').classList.remove('hidden');
            document.getElementById('viewGame').classList.add('flex');

            showToast(`已進入房間 [${room}]，登入名稱：${name}`, 'success');

            // Start Polling Loop
            pollState();
            if (state.pollingTimer) clearInterval(state.pollingTimer);
            state.pollingTimer = setInterval(pollState, 2000);
        }

        function leaveRoom() {
            if (confirm('確定要離開目前房間嗎？')) {
                sfx.playClick();
                if (state.pollingTimer) clearInterval(state.pollingTimer);
                state.pollingTimer = null;
                
                document.getElementById('viewGame').classList.add('hidden');
                document.getElementById('viewGame').classList.remove('flex');
                document.getElementById('viewLogin').classList.remove('hidden');
            }
        }

        function goHomeIfConfirmed() {
            if (!document.getElementById('viewGame').classList.contains('hidden')) {
                leaveRoom();
            }
        }

        function copyRoomLink() {
            sfx.playClick();
            const textToCopy = state.roomCode;
            
            // Clipboard copy standard approach
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(textToCopy).then(() => {
                    showToast('房間號碼已複製到剪貼簿！', 'success');
                }).catch(() => fallbackCopy(textToCopy));
            } else {
                fallbackCopy(textToCopy);
            }
        }

        function fallbackCopy(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast('房間號碼已複製！', 'success');
        }

        // ================= HIDDEN HOST PANEL TOGGLE =================
        function toggleHostPanel() {
            sfx.playClick();
            setHostPanelVisibility(!state.hostPanelVisible);
        }

        function setHostPanelVisibility(visible) {
            state.hostPanelVisible = visible;
            const panel = document.getElementById('hostPanel');
            if (visible) {
                panel.classList.remove('hidden');
                showToast('已開啟房主控制台 👑', 'info');
            } else {
                panel.classList.add('hidden');
            }
        }

        function setPresetQuestion(q) {
            sfx.playClick();
            document.getElementById('hostQuestionInput').value = q;
        }

        // ================= API FETCH & POLLING MECHANISM =================

        async function fetchRoomData(room) {
            if (state.localFallbackMode) {
                return localSimulatedDB[room] || { status: 'setup', question: '', answers: {} };
            }

            try {
                const url = `${GAS_API_URL}?room=${encodeURIComponent(room)}&t=${Date.now()}`;
                const response = await fetch(url, { method: 'GET' });
                if (!response.ok) throw new Error('HTTP network error');
                const data = await response.json();
                updateConnectionStatus(true, 'GAS 即時連線');
                return data;
            } catch (err) {
                console.warn('GAS Fetch failed, switching to fallback mode or using cached structure:', err);
                updateConnectionStatus(false, '本地模擬模式 (API受限)');
                state.localFallbackMode = true;
                if (!localSimulatedDB[room]) {
                    localSimulatedDB[room] = { status: state.status, question: state.question, answers: state.answers };
                }
                return localSimulatedDB[room];
            }
        }

        async function sendGameAction(payload) {
            payload.room = state.roomCode;

            if (state.localFallbackMode) {
                // Local simulation mode handler
                let roomData = localSimulatedDB[state.roomCode] || { status: 'setup', question: '', answers: {} };
                if (payload.action === 'reset') {
                    roomData.status = 'setup';
                    roomData.question = '';
                    roomData.answers = {};
                } else if (payload.action === 'set_question') {
                    roomData.status = 'playing';
                    roomData.question = payload.question;
                    roomData.answers = {};
                } else if (payload.action === 'submit_answer') {
                    roomData.answers[payload.playerName] = payload.answer;
                } else if (payload.action === 'reveal') {
                    roomData.status = 'revealed';
                }
                localSimulatedDB[state.roomCode] = roomData;
                return { success: true };
            }

            try {
                // Note: using text/plain prevents CORS preflight OPTIONS request issues on Google Apps Script
                const response = await fetch(GAS_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                return result;
            } catch (err) {
                console.warn('POST action failed, falling back to local simulation:', err);
                state.localFallbackMode = true;
                return sendGameAction(payload); // Retry in fallback mode
            }
        }

        function updateConnectionStatus(isOnline, text) {
            const badge = document.getElementById('connectionBadge');
            const dot = document.getElementById('connDot');
            const label = document.getElementById('connText');
            badge.classList.remove('hidden');
            label.textContent = text;
            if (isOnline) {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
            } else {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
            }
        }

        async function pollState() {
            if (!state.roomCode) return;

            const data = await fetchRoomData(state.roomCode);
            if (!data) return;

            const newStatus = data.status || 'setup';
            const newQuestion = data.question || '';
            const newAnswers = data.answers || {};

            const rawAnswersJSON = JSON.stringify(newAnswers);
            const statusChanged = (state.status !== newStatus);
            const answersChanged = (state.lastRawAnswersJSON !== rawAnswersJSON);

            state.previousStatus = state.status;
            state.status = newStatus;
            state.question = newQuestion;
            state.answers = newAnswers;
            state.lastRawAnswersJSON = rawAnswersJSON;

            // Trigger reveal sound effect when transition happens
            if (statusChanged && newStatus === 'revealed') {
                sfx.playFanfare();
            }

            renderGameUI(statusChanged, answersChanged);
        }

        // ================= HOST ACTIONS =================

        async function hostSetQuestion() {
            sfx.playClick();
            const qInput = document.getElementById('hostQuestionInput');
            const questionText = qInput.value.trim();

            if (!questionText) {
                showToast('請輸入題目內容！', 'error');
                return;
            }

            showToast('正在發布題目...', 'info');
            await sendGameAction({
                action: 'set_question',
                question: questionText
            });
            qInput.value = '';
            showToast('題目發布成功！大家快填答！', 'success');
            pollState();
        }

        async function hostRevealAnswers() {
            sfx.playClick();
            const count = Object.keys(state.answers).length;
            if (count === 0) {
                showToast('目前尚無人回答，無法開牌！', 'error');
                return;
            }
            showToast('正在開牌揭曉...', 'info');
            await sendGameAction({ action: 'reveal' });
            pollState();
        }

        async function hostResetRound() {
            sfx.playClick();
            showToast('正在重置本輪遊戲...', 'info');
            await sendGameAction({ action: 'reset' });
            document.getElementById('inputPlayerAnswer').value = '';
            document.getElementById('submitStatusText').classList.add('hidden');
            pollState();
            showToast('房間已重置為準備階段！', 'success');
        }

        // ================= PLAYER ACTIONS =================

        async function handleAnswerSubmit(e) {
            e.preventDefault();
            sfx.playClick();

            const ansInput = document.getElementById('inputPlayerAnswer');
            const answer = ansInput.value.trim();

            if (!answer) {
                showToast('請填寫答案！', 'error');
                return;
            }

            if (state.status !== 'playing') {
                showToast('目前非答題階段！', 'error');
                return;
            }

            const btn = document.getElementById('btnSubmitAnswer');
            btn.disabled = true;
            btn.opacity = '0.7';

            await sendGameAction({
                action: 'submit_answer',
                playerName: state.playerName,
                answer: answer
            });

            btn.disabled = false;
            btn.opacity = '1';
            document.getElementById('submitStatusText').classList.remove('hidden');
            showToast('心電答案已成功發送！', 'success');
            pollState();
        }

        // ================= RENDER ENGINE =================

        function renderGameUI(statusChanged, answersChanged) {
            const questionElem = document.getElementById('displayQuestion');
            const roundBadge = document.getElementById('roundStatusBadge');
            const submitSection = document.getElementById('sectionPlayerSubmit');
            const resultsSection = document.getElementById('sectionResults');

            // 1. Update Question & Stage Badge
            if (state.status === 'setup') {
                roundBadge.textContent = '準備階段 🍵';
                roundBadge.className = 'inline-block px-3 py-1 bg-mustard text-kraft-900 text-xs font-black rounded-full border-2 border-kraft-900 mb-3';
                questionElem.textContent = '靜候房主派發題目中...';
                submitSection.classList.add('hidden');
                resultsSection.classList.add('hidden');
            } else if (state.status === 'playing') {
                roundBadge.textContent = '心電對決進行中 ⚡';
                roundBadge.className = 'inline-block px-3 py-1 bg-matcha text-white text-xs font-black rounded-full border-2 border-kraft-900 mb-3 animate-pulse-gentle';
                questionElem.textContent = state.question || '請聽題！';
                submitSection.classList.remove('hidden');
                resultsSection.classList.add('hidden');
            } else if (state.status === 'revealed') {
                roundBadge.textContent = '結果已揭曉 🎴';
                roundBadge.className = 'inline-block px-3 py-1 bg-terracotta text-white text-xs font-black rounded-full border-2 border-kraft-900 mb-3';
                questionElem.textContent = state.question || '本輪題目';
                submitSection.classList.add('hidden');
                resultsSection.classList.remove('hidden');
            }

            // 2. Render Player Cards Grid
            renderCardsGrid();

            // 3. Render Results Analysis if revealed
            if (state.status === 'revealed') {
                calculateResults();
            }
        }

        function renderCardsGrid() {
            const grid = document.getElementById('cardsGrid');
            const emptyState = document.getElementById('cardsEmptyState');
            const countBadge = document.getElementById('answerCountBadge');

            const players = Object.keys(state.answers);
            countBadge.textContent = `${players.length} 人已填答`;

            if (players.length === 0) {
                emptyState.classList.remove('hidden');
                grid.innerHTML = '';
                return;
            }
            emptyState.classList.add('hidden');

            // Map color palette for revealed identical answers
            const matchColorMap = assignMatchColors(state.answers);

            let html = '';
            players.forEach((pName, index) => {
                const answerText = state.answers[pName] || '';
                const isCurrentPlayer = (pName === state.playerName);
                const isRevealed = (state.status === 'revealed');
                
                // Color assignments
                const matchInfo = matchColorMap[answerText] || { bg: 'bg-kraft-50', border: 'border-kraft-900', text: 'text-kraft-900', badge: 'bg-kraft-200 text-kraft-900' };

                html += `
                <div class="perspective-1000 h-44 sm:h-48 w-full">
                    <div id="card-inner-${index}" class="card-inner ${isRevealed ? 'is-flipped' : ''}">
                        
                        <!-- CARD FRONT (Unrevealed Back Pattern) -->
                        <div class="card-front seigaiha-pattern border-3 border-kraft-900 rounded-xl p-4 flex flex-col justify-between shadow-retro text-kraft-50 select-none">
                            <div class="flex justify-between items-start">
                                <span class="text-xs font-black px-2 py-0.5 bg-kraft-900/80 rounded border border-kraft-200">
                                    ${isCurrentPlayer ? '你 (You)' : '🎴 心電牌'}
                                </span>
                                <div class="w-6 h-6 rounded-full border border-kraft-200 flex items-center justify-center font-serifTC text-xs">
                                    心
                                </div>
                            </div>

                            <div class="text-center my-auto">
                                <div class="font-black text-lg sm:text-xl truncate text-amber-200 font-serifTC">
                                    ${escapeHTML(pName)}
                                </div>
                                <div class="text-xs font-bold opacity-90 mt-1">
                                    ${state.status === 'playing' ? '✓ 已準備 (Hidden)' : '等待出題...'}
                                </div>
                            </div>

                            <div class="text-center text-[10px] tracking-widest uppercase opacity-75 font-bold">
                                Cloud Telepathy
                            </div>
                        </div>

                        <!-- CARD BACK (Revealed Front Side) -->
                        <div class="card-back ${matchInfo.bg} border-3 ${matchInfo.border} rounded-xl p-4 flex flex-col justify-between shadow-retro text-kraft-900">
                            <div class="flex justify-between items-center border-b border-kraft-900/20 pb-1.5">
                                <span class="font-black text-xs truncate max-w-[90px] ${matchInfo.text}">
                                    ${escapeHTML(pName)} ${isCurrentPlayer ? ' (你)' : ''}
                                </span>
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${matchInfo.badge}">
                                    已開牌
                                </span>
                            </div>

                            <div class="my-auto text-center px-1">
                                <span class="text-xs font-bold text-kraft-800 block mb-0.5">心電答案：</span>
                                <div class="font-black text-lg sm:text-xl ${matchInfo.text} font-serifTC break-all leading-snug">
                                    「 ${escapeHTML(answerText)} 」
                                </div>
                            </div>

                            <div class="text-right text-[10px] font-bold text-kraft-800">
                                默契印 💮
                            </div>
                        </div>

                    </div>
                </div>
                `;
            });

            grid.innerHTML = html;

            // Optional staggered flip effect when transition occurs
            if (state.previousStatus !== 'revealed' && state.status === 'revealed') {
                players.forEach((_, idx) => {
                    const cardElem = document.getElementById(`card-inner-${idx}`);
                    if (cardElem) {
                        cardElem.classList.remove('is-flipped');
                        setTimeout(() => {
                            cardElem.classList.add('is-flipped');
                            sfx.playFlip();
                        }, idx * 120);
                    }
                });
            }
        }

        // Assign colors based on answer frequencies for clear grouping
        function assignMatchColors(answers) {
            const counts = {};
            Object.values(answers).forEach(ans => {
                const normalized = ans.trim().toLowerCase();
                counts[normalized] = (counts[normalized] || 0) + 1;
            });

            const map = {};
            let colorIdx = 0;

            Object.keys(counts).forEach(ansKey => {
                if (counts[ansKey] > 1) {
                    map[ansKey] = MATCH_COLORS[colorIdx % MATCH_COLORS.length];
                    colorIdx++;
                }
            });

            // Fallback default color for unique answers
            return new Proxy(map, {
                get: (target, prop) => {
                    const norm = (prop || '').trim().toLowerCase();
                    return target[norm] || {
                        bg: 'bg-kraft-50',
                        border: 'border-kraft-900',
                        text: 'text-kraft-900',
                        badge: 'bg-kraft-200 text-kraft-900'
                    };
                }
            });
        }

        // ================= CALCULATE CONSENSUS & TELEPATHY SCORE =================
        function calculateResults() {
            const answersArray = Object.values(state.answers).map(a => a.trim().toLowerCase());
            const total = answersArray.length;

            if (total === 0) return;

            const freqMap = {};
            answersArray.forEach(ans => {
                freqMap[ans] = (freqMap[ans] || 0) + 1;
            });

            let maxMatches = 0;
            let topAnswer = '';

            Object.entries(freqMap).forEach(([ans, count]) => {
                if (count > maxMatches) {
                    maxMatches = count;
                    topAnswer = ans;
                }
            });

            // Find original casing for presentation
            const origTopAnswer = Object.values(state.answers).find(a => a.trim().toLowerCase() === topAnswer) || topAnswer;

            // Telepathy Score Formula: Percentage of the largest agreeing group
            const scorePercent = Math.round((maxMatches / total) * 100);

            document.getElementById('telepathyScore').textContent = `${scorePercent}%`;
            document.getElementById('topMatchText').textContent = `「${origTopAnswer}」(${maxMatches}人相同)`;

            const titleElem = document.getElementById('resultTitle');
            const subElem = document.getElementById('resultSubtitle');

            if (scorePercent === 100) {
                titleElem.textContent = '🎉 全員心電感應大成功！';
                subElem.textContent = '太不可思議了！所有人答案完全一致！';
            } else if (scorePercent >= 50) {
                titleElem.textContent = '✨ 默契十分良好！';
                subElem.textContent = `多數人都聯想到了「${origTopAnswer}」！`;
            } else {
                titleElem.textContent = '🌀 想法五花八門！';
                subElem.textContent = '大家的思維非常有創意，下輪再接再厲！';
            }
        }

        function escapeHTML(str) {
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
